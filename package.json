{
  "name": "shopclass",
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "esbuild": "^0.28.1",
    "eslint": "^9.21.0",
    "sass-embedded": "^1.100.0"
  },
  "description": "Shopclass is a free and open script to create your advertisement or listings site. Best features: Plugins, themes, multi-language, CAPTCHA, dashboard, SEO friendly.",
  "scripts": {
    "build": "npm run assets && npm run css && npm run js",
    "assets": "node scripts/copy-assets.mjs",
    "css": "node scripts/build-css.mjs",
    "js": "esbuild oc-admin/themes/modern/js/location.js --minify --sourcemap --outfile=oc-admin/themes/modern/js/location.min.js",
    "watch": "node scripts/build-css.mjs --watch",
    "lint": "eslint oc-admin/themes/modern/js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": "git+https://github.com/mindstellar/shopclass.git",
  "keywords": [
    "Classifieds",
    "Shopclass"
  ],
  "author": "Navjot Tomer",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mindstellar/shopclass/issues"
  },
  "homepage": "https://github.com/mindstellar/shopclass#readme",
  "dependencies": {
    "bootstrap": "^5.3.*",
    "bootstrap-icons": "^1.11.0",
    "chart.js": "^3.5.0",
    "jquery": "^3.7.1",
    "jquery-migrate": "^3.5.2",
    "jquery-treeview": "^1.4.*",
    "jquery-ui-dist": "^1.13.*",
    "jquery-ui-nested": "^1.3.*",
    "jquery-validation": "^1.21.0",
    "npm-font-open-sans": "^1.1.*",
    "osclass-legacy-assets": "github:mindstellar/osclass-legacy-assets#master",
    "sortablejs": "^1.15.6",
    "spectrum-colorpicker": "^1.8.*",
    "tinymce": "^7.7.0"
  }
}
