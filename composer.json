{
    "name": "mindstellar/shopclass",
    "type": "project",
    "description": "With Shopclass, get your own  classifieds site for free. Build your own Shopclass installation and start advertising real estate, jobs or whatever you want- in minutes! ",
    "keywords": [
        "shopclass",
        "classified",
        "open-source",
        "php-classified",
        "cms"
    ],
    "homepage": "https://github.com/mindstellar/shopclass",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Shopclass Community",
            "homepage": "https://github.com/mindstellar/shopclass/graphs/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "mindstellar\\admin\\": "oc-includes/classes/admin",
            "mindstellar\\api\\": "oc-includes/classes/api",
            "mindstellar\\apikey\\": "oc-includes/classes/user/apikey",
            "mindstellar\\auth\\": "oc-includes/classes/user/auth",
            "mindstellar\\backup\\": "oc-includes/classes/backup",
            "mindstellar\\base\\": "oc-includes/classes/core/base",
            "mindstellar\\billing\\": "oc-includes/classes/billing",
            "mindstellar\\boot\\": "oc-includes/classes/core/boot",
            "mindstellar\\cache\\": "oc-includes/classes/core/cache",
            "mindstellar\\category\\": "oc-includes/classes/listing/category",
            "mindstellar\\cli\\": "oc-includes/classes/core/cli",
            "mindstellar\\comment\\": "oc-includes/classes/content/comment",
            "mindstellar\\container\\": "oc-includes/classes/core/container",
            "mindstellar\\currency\\": "oc-includes/classes/billing/currency",
            "mindstellar\\database\\": "oc-includes/classes/core/database",
            "mindstellar\\event\\": "oc-includes/classes/core/event",
            "mindstellar\\exception\\": "oc-includes/classes/core/exception",
            "mindstellar\\fields\\": "oc-includes/classes/listing/fields",
            "mindstellar\\form\\": "oc-includes/classes/core/form",
            "mindstellar\\http\\": "oc-includes/classes/core/http",
            "mindstellar\\image\\": "oc-includes/classes/media/image",
            "mindstellar\\install\\": "oc-includes/classes/core/install",
            "mindstellar\\job\\": "oc-includes/classes/core/job",
            "mindstellar\\language\\": "oc-includes/classes/core/language",
            "mindstellar\\listing\\": "oc-includes/classes/listing",
            "mindstellar\\live\\": "oc-includes/classes/messaging/live",
            "mindstellar\\location\\": "oc-includes/classes/location",
            "mindstellar\\logger\\": "oc-includes/classes/core/logger",
            "mindstellar\\mail\\": "oc-includes/classes/core/mail",
            "mindstellar\\market\\": "oc-includes/classes/market",
            "mindstellar\\menu\\": "oc-includes/classes/content/menu",
            "mindstellar\\messaging\\": "oc-includes/classes/messaging",
            "mindstellar\\migration\\": "oc-includes/classes/core/migration",
            "mindstellar\\model\\": "oc-includes/classes/core/model",
            "mindstellar\\moderation\\": "oc-includes/classes/listing/moderation",
            "mindstellar\\pages\\": "oc-includes/classes/content/pages",
            "mindstellar\\privacy\\": "oc-includes/classes/user/privacy",
            "mindstellar\\push\\": "oc-includes/classes/messaging/push",
            "mindstellar\\routing\\": "oc-includes/classes/core/routing",
            "mindstellar\\search\\": "oc-includes/classes/search",
            "mindstellar\\security\\": "oc-includes/classes/core/security",
            "mindstellar\\seo\\": "oc-includes/classes/content/seo",
            "mindstellar\\settings\\": "oc-includes/classes/core/settings",
            "mindstellar\\site\\": "oc-includes/classes/core/site",
            "mindstellar\\storage\\": "oc-includes/classes/core/storage",
            "mindstellar\\theme\\": "oc-includes/classes/core/theme",
            "mindstellar\\upgrade\\": "oc-includes/classes/core/upgrade",
            "mindstellar\\user\\": "oc-includes/classes/user",
            "mindstellar\\utility\\": "oc-includes/classes/core/utility",
            "mindstellar\\webhook\\": "oc-includes/classes/webhook",
            "mindstellar\\widgets\\": "oc-includes/classes/content/widgets"
        },
        "classmap": [
            "oc-includes/osclass",
            "oc-includes/AjaxUploader.php",
            "oc-includes/Akismet.class.php"
        ]
    },
    "config": {
        "vendor-dir": "oc-includes/vendor",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mysqli": "*",
        "ext-zip": "*",
        "ext-curl": "*",
        "ext-posix": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ezyang/htmlpurifier": "4.19.*",
        "phpmailer/phpmailer": "^7.0",
        "google/recaptcha": "^1.3",
        "gettext/gettext": "4.8.*",
        "async-aws/s3": "^3.5"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "scripts": {
        "test": "php tests/run-unit.php",
        "test:models": "php tests/run-models.php",
        "cs:install": "mkdir -p tools && curl -fsSL -o tools/php-cs-fixer.phar https://github.com/PHP-CS-Fixer/PHP-CS-Fixer/releases/download/v3.64.0/php-cs-fixer.phar",
        "cs:check": "php tools/php-cs-fixer.phar fix --dry-run --diff",
        "cs:fix": "php tools/php-cs-fixer.phar fix",
        "lint:install": "composer install --working-dir=tools/lint --no-interaction",
        "compat": "php tools/lint/vendor/bin/phpcs --standard=.phpcompat.xml.dist",
        "analyse": "php -d memory_limit=4G tools/lint/vendor/bin/phpstan analyse --no-progress",
        "lint": [
            "@cs:check",
            "@compat",
            "@analyse"
        ]
    },
    "suggest": {
        "ext-apcu": "Fast PHP user cache",
        "ext-memcached": "Enables the 'memcached' object cache driver (set OSC_CACHE='memcached')",
        "ext-imagick": "Will enable to use Imagick library for image manipulation"
    }
}
