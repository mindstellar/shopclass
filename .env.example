# Copy to .env to change anything below. The file is gitignored, so it is yours alone;
# every value here has a working default, and the dev stack runs without it.
#
#   cp .env.example .env

# --- Which compose files to use ------------------------------------------------------
#
# The dev stack is docker-compose.dev.yml rather than docker-compose.yml, so that the
# filename says which stack it is beside docker-compose.prod.yml. Plain `docker compose`
# cannot find that on its own, which is what this line fixes.
#
# Leave it set. Every entry point reads it — npm run dev and a bare `docker compose`
# both, which is the point: passing -f from npm instead would override this line, and
# the two commands would quietly bring up different stacks.
COMPOSE_FILE=docker-compose.dev.yml

# Add your own file to the list — colon-separated, later files win — for mounts that
# only make sense on your machine: a theme or plugin checked out beside this repo, an
# extra service. docker-compose.local.yml is gitignored for exactly this.
#
# A listed file has to exist, so add it only once you have created one:
#
# COMPOSE_FILE=docker-compose.dev.yml:docker-compose.local.yml
#
# Themes need mounting into BOTH php-fpm and webserver — one renders the theme, the
# other serves its assets — so a mount added to only one gives a page with no CSS:
#
#   services:
#     php-fpm:
#       volumes: [ "../theme-storefront:/application/oc-content/themes/storefront" ]
#     webserver:
#       volumes: [ "../theme-storefront:/application/oc-content/themes/storefront" ]

# --- File ownership ------------------------------------------------------------------
#
# The container's worker runs as this uid/gid so that files it writes into the bind
# mount belong to you rather than to root. Defaults suit the common single-user Linux
# install; run `id -u` and `id -g` if yours differ. Ignored on Docker Desktop.

# PUID=1000
# PGID=1000

# --- Database ------------------------------------------------------------------------
#
# Used by both the mariadb service and the php-fpm service that connects to it, so a
# change here applies to both. Only meaningful before the database volume is first
# created — afterwards the credentials are already baked into it, and changing these
# will lock you out until you remove the volume.

# MYSQL_ROOT_PASSWORD=root
# SHOPCLASS_DATABASE_NAME=shopclass
# SHOPCLASS_DATABASE_USER=shopclass
# SHOPCLASS_DATABASE_PASSWORD=shopclass
